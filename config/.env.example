# open-travel 环境变量示例 —— 复制为 .env 并替换所有占位符，勿提交真实值

# MySQL（主写从读：应用层以 master/slave 双连接池路由）
DATABASE_URL=mysql://root:your_mysql_password_here@localhost:3306/travel
DATABASE_URL_SLAVE=mysql://root:your_mysql_password_here@localhost:3306/travel

# Redis（会话 TTL 30 分钟、热门缓存 TTL 5 分钟）
REDIS_URL=redis://localhost:6379

# JWT 签名密钥（生产必须替换为强随机值，如 openssl rand -hex 32）
JWT_SECRET=your_jwt_secret_please_replace

# docker-compose 使用
MYSQL_ROOT_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=travel

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
